# Deploy-time config for the always-on worker. Copy to deploy/.env.deploy and fill
# in REAL values — deploy/.env.deploy is gitignored and MUST NEVER be committed.
# deploy/deploy.sh loads this file and injects every var into the running container
# (Fly: `fly secrets import`; GCE: `--container-env`).
#
# This is the worker's full runtime surface (a subset of .env.example — the deploy
# uses the Vertex express-mode key, not the dev GEMINI_API_KEY free tier).

# --- Slack tokens (required) ---
# From api.slack.com/apps -> your app. The bot token (xoxb-) and the app-level
# token (xapp-, connections:write) — socket mode needs BOTH.
SLACK_BOT_TOKEN=xoxb-REPLACE-ME
SLACK_APP_TOKEN=xapp-REPLACE-ME

# --- AI provider (required) ---
# Vertex AI express-mode key (project-billed Gemini, no free-tier daily caps).
# Cloud-agnostic — works the same on Fly or GCE. See agent/agent.py get_model().
GOOGLE_VERTEX_API_KEY=REPLACE-ME-vertex-express-key

# --- Slack user token (required for RTS recall + canvas board) ---
# The installed app's User OAuth Token (xoxp-). Powers Real-Time Search recall,
# the Slack MCP toolset, and the coordinator board canvas writes.
SLACK_USER_TOKEN=xoxp-REPLACE-ME

# --- Channel wiring (required for the demo behaviour) ---
# Passive-listening channel id (ADR-0004) and coordinator-board announce channel
# id (ADR-0005). Channel ids look like C0123456789.
CRISIS_CHANNEL=C0123456789
COORDINATOR_CHANNEL=C0123456789

# --- Startup backfill (recommended: true on a deployed worker) ---
# Repopulate the in-memory offer index from CRISIS_CHANNEL history on every start,
# so prior/seeded offers reach the coordinator board after a restart (ADR-0006).
# Unlike dev (file-watcher restarts), a deployed worker restarts rarely — keep this
# on so a crash-restart self-heals the board.
BACKFILL_ON_START=true
