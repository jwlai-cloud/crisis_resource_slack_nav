# Config surface for Crisis Resource Navigator.
# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# --- AI provider (pydantic-ai) ---
# Required: set at least one. Preference order when several are set:
# Anthropic > OpenAI > Gemini (see agent/agent.py get_model()).
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Slack tokens ---
# Optional: `slack run` injects these automatically. Only needed when running
# without the Slack CLI (python3 app.py).
# SLACK_APP_TOKEN=xapp-dummy
# SLACK_BOT_TOKEN=xoxb-dummy

# --- Passive listening (ADR-0004) ---
# The agent passively listens — parses every top-level message and acks offers /
# answers needs in-thread — in ONE designated channel only; everywhere else stays
# mention-gated. Set to that channel's id (e.g. C0123456789). Empty/unset = feature
# off (no passive listening anywhere). Chatter in the channel is parsed but never
# answered. Widening to more channels is a config + restart, one channel at a time.
# CRISIS_CHANNEL=C0123456789

# --- Startup offer-index backfill (task 026, ADR-0006) ---
# On startup, sweep CRISIS_CHANNEL's message history, parse each message, and add
# every parsed Offer to the in-memory index so seeded/prior offers show on the
# coordinator board (the index is otherwise wiped on every restart — ADR-0003).
# Opt-in (default off): the dev file-watcher restarts the agent on every .py save,
# and an always-on backfill would fire an LLM parse per history message each time.
# Also gated on CRISIS_CHANNEL being set. Set true for the demo, then restart.
BACKFILL_ON_START=false

# --- Coordinator board discoverability (task 018, ADR-0005) ---
# When the coordinator board Canvas is first created (by `make board` or the
# agent's first board refresh), post its link ONCE to this channel so a coordinator
# can open it. Set to that channel's id (e.g. C0123456789). Empty/unset = off (no
# announce; the board is still created, just not advertised). Same pattern as
# CRISIS_CHANNEL — one channel, change + restart to move it.
# COORDINATOR_CHANNEL=C0123456789

# --- OAuth mode (app_oauth.py; not used for the sandbox demo) ---
# SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
# SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
# SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
# SLACK_REDIRECT_URI=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app/slack/oauth_redirect

# Optional: override the Gemini model (free-tier quotas are per model —
# switch to gemini-2.5-flash-lite when gemini-2.5-flash hits its daily cap).
# GEMINI_MODEL=gemini-2.5-flash-lite

# Socket-mode dev only: the installed app's User OAuth Token (xoxp-...), from
# api.slack.com/apps -> your app -> OAuth & Permissions. Powers RTS search and
# the Slack MCP toolset locally; OAuth deployments get this from context instead.
# Also used by `make board` (canvases:write) and `make seed-demo`, which posts the
# demo scenario as the operator into CRISIS_CHANNEL and needs chat:write +
# channels:history (the latter for the idempotency scan + --fresh cleanup).
# SLACK_USER_TOKEN=xoxp-dummy

# Vertex AI express-mode key (personal GCP project) — project-billed Gemini,
# no free-tier daily caps. Preferred over GEMINI_API_KEY when both are set.
# GOOGLE_VERTEX_API_KEY=YOUR_VERTEX_EXPRESS_API_KEY

# --- Mock official-directories MCP server (mocks/server.py) ---
# Thin FastMCP mocks for road closures / evac centres / official advice. Enabled
# by default. Never wires real government feeds.
#
# Transport (task 034): by default the agent spawns the server as a stdio subprocess
# (python -m mocks.server) per run — zero-config, what local `slack run` uses, leave
# these UNSET. In the deployed container deploy/entrypoint.sh instead runs the server
# PERSISTENTLY over HTTP and points the agent at it (warm, no per-reply spawn): the
# entrypoint sets MOCK_MCP_HTTP_PORT (the server then serves transport=http on
# 127.0.0.1:<port>) and MOCK_MCP_URL (the agent connects via MCPServerStreamableHTTP).
# You normally never set these by hand — the entrypoint does. Local override only:
# MOCK_MCP_HTTP_PORT=8765
# MOCK_MCP_URL=http://127.0.0.1:8765/mcp
#
# Kill-switch: set to 1 to detach the mock server from the agent's toolsets.
# MOCK_MCP_DISABLED=1
# Demo degraded-state cue: comma-separated feed name(s) to force "down" so the
# agent shows the degraded guardrail on cue. Names: road_closures, evac_centres,
# official_advice.
# MOCK_FEED_DOWN=road_closures
